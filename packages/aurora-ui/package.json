{
  "name": "@aurora/ui",
  "version": "1.0.0",
  "description": "Production React shell, design tokens, and SDK-bound UI primitives for Aurora.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./local-data": {
      "types": "./src/local-data/index.ts",
      "import": "./src/local-data/index.ts",
      "default": "./src/local-data/index.ts"
    },
    "./local-data/browser": {
      "types": "./src/local-data/browser.ts",
      "import": "./src/local-data/browser.ts",
      "default": "./src/local-data/browser.ts"
    },
    "./local-assistant": {
      "types": "./src/local-assistant/index.ts",
      "import": "./src/local-assistant/index.ts",
      "default": "./src/local-assistant/index.ts"
    },
    "./admin-audit-view": "./src/admin-audit-view.tsx",
    "./admin-devices-view": "./src/admin-devices-view.tsx",
    "./admin-plugins-view": "./src/admin-plugins-view.tsx",
    "./admin-rbac-view": "./src/admin-rbac-view.tsx",
    "./admin-scheduler-view": "./src/admin-scheduler-view.tsx",
    "./admin-services-view": "./src/admin-services-view.tsx",
    "./admin-tokens-view": "./src/admin-tokens-view.tsx",
    "./backup-restore-view": "./src/backup-restore-view.tsx",
    "./config-editor-view": "./src/config-editor-view.tsx",
    "./data-policy-view": "./src/data-policy-view.tsx",
    "./models-view": "./src/models-view.tsx",
    "./pairing-queue-view": "./src/pairing-queue-view.tsx",
    "./voice-settings-view": "./src/voice-settings-view.tsx",
    "./mesh-peers-view": "./src/mesh-peers-view.tsx",
    "./service-routing-view": "./src/service-routing-view.tsx",
    "./assistant-view": "./src/assistant-view.tsx",
    "./assistant-stream-store": "./src/assistant-stream-store.ts",
    "./admin-overview-view": "./src/admin-overview-view.tsx",
    "./memory-view": "./src/memory-view.tsx",
    "./mesh-diagnostics-resource": "./src/mesh-diagnostics-resource.tsx",
    "./nav": "./src/nav.tsx",
    "./onboarding-view": "./src/onboarding-view.tsx",
    "./owl-loader": "./src/owl-loader.tsx",
    "./platform-surface": "./src/platform-surface.ts",
    "./primitives": "./src/primitives.tsx",
    "./runtime-profile": "./src/runtime-profile.ts",
    "./settings-permissions-view": "./src/settings-permissions-view.tsx",
    "./settings-view": "./src/settings-view.tsx",
    "./shell": "./src/shell.tsx",
    "./shell-data": "./src/shell-data.ts",
    "./state-surface": "./src/state-surface.tsx",
    "./status-badges": "./src/status-badges.tsx",
    "./tool-approval-panel": "./src/tool-approval-panel.tsx",
    "./thin-connection-profile": "./src/thin-connection-profile.ts",
    "./web-thin-connection-panel": "./src/web-thin-connection-panel.tsx",
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/shadcn-lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/get-strict-context": "./src/shadcn-lib/get-strict-context.tsx"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:workspace-dependencies && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "build:workspace-dependencies": "pnpm --dir ../.. --filter @aurora/client build && pnpm --dir ../.. --filter @aurora/voice-web build",
    "typecheck": "pnpm run build:workspace-dependencies && tsc --noEmit --incremental false",
    "test": "pnpm run build:workspace-dependencies && vitest run --environment node --exclude 'dist/**'",
    "test:accessibility": "pnpm run build:workspace-dependencies && vitest run --environment node tests/accessibility-responsive-visual.test.tsx",
    "test:coverage": "pnpm run build:workspace-dependencies && vitest run --environment node --exclude 'dist/**' --coverage"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@assistant-ui/react-mcp": "^0.0.17",
    "@assistant-ui/react-syntax-highlighter": "^0.14.2",
    "@assistant-ui/store": "^0.2.19",
    "@aurora/client": "workspace:*",
    "@aurora/voice-web": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@floating-ui/react": "^0.27.19",
    "@shadcn/react": "^0.2.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "heat-graph": "^0.0.12",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "parse-diff": "^0.12.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.1",
    "react": "^19",
    "react-resizable-panels": "^4.12.1",
    "react-shiki": "^0.10.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-shimmer": "^0.4.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "4.1.9",
    "axe-core": "^4.12.1",
    "jsdom": "^27.4.0",
    "react-dom": "^19",
    "typescript": "5.7.3",
    "vitest": "^4.0.16"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/shadcn-lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/get-strict-context": "./src/shadcn-lib/get-strict-context.tsx"
  }
}
