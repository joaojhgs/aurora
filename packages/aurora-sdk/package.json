{
  "name": "@aurora/client",
  "version": "0.1.0",
  "description": "Transport-independent TypeScript client SDK for Aurora Gateway and native adapters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js",
      "default": "./dist/test-utils.js"
    },
    "./webrtc-protocol-contract": {
      "types": "./dist/webrtc-protocol-contract.d.ts",
      "import": "./dist/webrtc-protocol-contract.js",
      "default": "./dist/webrtc-protocol-contract.js"
    },
    "./webrtc": {
      "types": "./dist/webrtc/index.d.ts",
      "import": "./dist/webrtc/index.js",
      "default": "./dist/webrtc/index.js"
    },
    "./local-data": {
      "types": "./dist/local-data/index.d.ts",
      "import": "./dist/local-data/index.js",
      "default": "./dist/local-data/index.js"
    },
    "./generated": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "default": "./dist/validation/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --environment node",
    "test:resilience": "vitest run --environment node tests/performance-offline-resilience.test.ts"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "mqtt": "5.15.2",
    "zod": "4.4.3"
  }
}
