{
  "projectId": "88e16254-51d7-4a78-91b7-4e448e35a73f",
  "pkg": "@aurora/ui-mock-reference",
  "globalName": "Aurora",
  "shape": "package",
  "srcDir": "components",
  "cssEntry": ".design-sync/.cache/compiled/app.css",
  "tsconfig": "tsconfig.json",
  "buildCmd": "pnpm build && mkdir -p .design-sync/.cache/compiled .design-sync/.cache/media && cp .next/static/chunks/*.css .design-sync/.cache/compiled/app.css && cp .next/static/media/*.woff2 .design-sync/.cache/media/ && echo '.p-6{padding:calc(var(--spacing) * 6)}' >> .design-sync/.cache/compiled/app.css",
  "excludeSrcFiles": [
    "components/aurora/app-shell.tsx"
  ],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single", "primaryStory": "Default" },
    "DropdownMenu": { "cardMode": "single", "primaryStory": "Default" },
    "AdminSecondarySurface": { "viewport": "1300x700" },
    "RouteSheet": { "cardMode": "single", "primaryStory": "Default" },
    "AdminConfirmDialog": { "cardMode": "single", "primaryStory": "HighRisk" },
    "CapabilityDrawer": { "cardMode": "single", "primaryStory": "Available" },
    "DiagnosticsView": { "cardMode": "single", "primaryStory": "Default" },
    "Progress": { "cardMode": "single", "primaryStory": "Default" },
    "Select": { "cardMode": "single", "primaryStory": "Open" },
    "Sheet": { "cardMode": "single", "primaryStory": "Default" },
    "Tooltip": { "cardMode": "single", "primaryStory": "Default" },
    "MeshView": { "cardMode": "single", "primaryStory": "Default" },
    "ModelsView": { "cardMode": "single", "primaryStory": "Default" },
    "OnboardingView": { "cardMode": "single", "primaryStory": "Default" }
  },
  "libOverrides": {
    "source-kit.mjs": "adds cfg.excludeSrcFiles — app-shell.tsx imports next/link + next/navigation, pulling Next's router runtime (process.env.__NEXT_* refs) into the shared IIFE and breaking window.Aurora for every component; AppShell also can't render outside a real Next.js app-router context",
    "common.mjs": "adds 'excludeSrcFiles' to CONFIG_KEYS so the source-kit.mjs fork's config field validates"
  },
  "componentSrcMap": {
