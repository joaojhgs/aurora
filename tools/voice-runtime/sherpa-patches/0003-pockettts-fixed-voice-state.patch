+    return PocketFileReadStatus::kError;
+  }
+  int32_t size = static_cast<int32_t>(raw_size);
+  data->resize(static_cast<size_t>(size));
+  int32_t count = size == 0 ? 0 : OH_ResourceManager_ReadRawFile(
+                                        file.get(), data->data(), size);
+  if (count != size) {
+    data->clear();
+    return PocketFileReadStatus::kError;
+  }
+  return PocketFileReadStatus::kRead;
+}
