+template <typename ReadFileFn>
+static bool LoadPocketFixedVoiceState(
+    const nlohmann::json &j, const std::string &dir,
+    const ReadFileFn &read_file,
+    PocketTtsFixedVoiceState *metadata, std::vector<float> *cache) {
+  PocketTtsFixedVoiceState candidate;
+  cache->clear();
+  if (!j.is_object()) {
+    SHERPA_ONNX_LOGE("PocketTTS fixed_voice_state metadata is not an object");
+    return false;
+  }
+  if (j.size() != 9) {
+    SHERPA_ONNX_LOGE("PocketTTS fixed voice metadata fields are incompatible");
+    return false;
+  }
+  try {
+    candidate.schema_version = j.at("schema_version").get<int32_t>();
+    candidate.file = j.at("file").get<std::string>();
+    candidate.dtype = j.at("dtype").get<std::string>();
+    candidate.layers = j.at("layers").get<int64_t>();
+    candidate.frames = j.at("frames").get<int64_t>();
+    candidate.heads = j.at("heads").get<int64_t>();
+    candidate.head_dim = j.at("head_dim").get<int64_t>();
+    candidate.byte_size = j.at("byte_size").get<int64_t>();
+    candidate.sha256 = j.at("sha256").get<std::string>();
+  } catch (const nlohmann::json::exception &e) {
+    SHERPA_ONNX_LOGE("Invalid PocketTTS fixed voice metadata: %s", e.what());
+    return false;
+  }
+  if (candidate.schema_version != 1 ||
+      !PocketSafeSidecarName(candidate.file) ||
+      candidate.dtype != "float32-le" || candidate.layers <= 0 ||
+      candidate.frames <= 0 || candidate.heads <= 0 ||
+      candidate.head_dim <= 0 || candidate.byte_size <= 0 ||
+      !PocketSha256MetadataIsValid(candidate.sha256)) {
+    SHERPA_ONNX_LOGE("PocketTTS fixed voice metadata is incompatible");
+    return false;
+  }
+
+  uint64_t expected = static_cast<uint64_t>(candidate.layers);
+  for (int64_t factor : {int64_t{2}, candidate.frames, candidate.heads,
+                         candidate.head_dim, int64_t{sizeof(float)}}) {
+    if (!PocketCheckedMultiply(expected, static_cast<uint64_t>(factor),
+                               &expected)) {
+      SHERPA_ONNX_LOGE("PocketTTS fixed voice size overflows");
+      return false;
+    }
+  }
+  // Bound allocations before reading untrusted protocol metadata. Aurora also
+  // verifies the signed pack/archive digest and the recorded sidecar digest at
+  // install time; this loader independently enforces the ABI shape and size.
+  constexpr uint64_t kMaxFixedVoiceBytes = 384ULL * 1024ULL * 1024ULL;
+  if (expected != static_cast<uint64_t>(candidate.byte_size) ||
+      expected > kMaxFixedVoiceBytes ||
+      expected > std::numeric_limits<size_t>::max()) {
+    SHERPA_ONNX_LOGE("PocketTTS fixed voice byte size is incompatible");
+    return false;
+  }
+
+  std::string state_path = PocketJoinPath(dir, candidate.file);
+  std::vector<char> raw;
+  PocketFileReadStatus status = read_file(state_path, &raw);
+  if (status != PocketFileReadStatus::kRead) {
+    SHERPA_ONNX_LOGE("Missing PocketTTS fixed voice sidecar: %s",
+                     state_path.c_str());
+    return false;
+  }
+  if (raw.size() != expected) {
+    SHERPA_ONNX_LOGE("PocketTTS fixed voice sidecar size mismatch: %s",
+                     state_path.c_str());
+    return false;
+  }
+  if (!DecodePocketFloat32Le(raw, cache)) {
+    SHERPA_ONNX_LOGE("Invalid PocketTTS fixed voice sidecar encoding: %s",
+                     state_path.c_str());
+    return false;
+  }
+  candidate.configured = true;
+  *metadata = std::move(candidate);
+  return true;
+}
