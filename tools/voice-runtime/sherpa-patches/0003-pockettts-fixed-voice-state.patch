+static std::string PocketJoinPath(const std::string &dir,
+                                  const std::string &name) {
+  if (dir.empty() || dir == ".") {
+    return name;
+  }
+  if (dir == "/") {
+    return dir + name;
+  }
+  return dir + "/" + name;
+}
+
+static bool PocketSafeSidecarName(const std::string &name) {
+  if (name.empty() || name == "." || name == "..") {
+    return false;
+  }
+  for (unsigned char ch : name) {
+    bool alpha_numeric = (ch >= 'a' && ch <= 'z') ||
+                         (ch >= 'A' && ch <= 'Z') ||
+                         (ch >= '0' && ch <= '9');
+    if (!alpha_numeric && ch != '.' && ch != '_' && ch != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool PocketSha256MetadataIsValid(const std::string &sha256) {
+  if (sha256.size() != 64) {
+    return false;
+  }
+  for (unsigned char ch : sha256) {
+    bool digit = ch >= '0' && ch <= '9';
+    bool lower_hex = ch >= 'a' && ch <= 'f';
+    if (!digit && !lower_hex) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool PocketCheckedMultiply(uint64_t lhs, uint64_t rhs,
+                                  uint64_t *result) {
+  if (lhs != 0 && rhs > std::numeric_limits<uint64_t>::max() / lhs) {
+    return false;
+  }
+  *result = lhs * rhs;
+  return true;
+}
+
+enum class PocketFileReadStatus { kMissing, kRead, kError };
+
+static PocketFileReadStatus ReadPocketFile(const std::string &path,
+                                           std::vector<char> *data) {
+  data->clear();
+  if (!FileExists(path)) {
+    return PocketFileReadStatus::kMissing;
+  }
+  auto file = OpenInputFile(path, std::ios::binary | std::ios::ate);
+  if (!file.is_open()) {
+    return PocketFileReadStatus::kError;
+  }
+  std::streamsize size = file.tellg();
+  if (size < 0) {
+    return PocketFileReadStatus::kError;
+  }
+  file.seekg(0, std::ios::beg);
+  data->resize(static_cast<size_t>(size));
+  if (size != 0 && !file.read(data->data(), size)) {
+    data->clear();
+    return PocketFileReadStatus::kError;
+  }
+  return PocketFileReadStatus::kRead;
+}
+
+#if __ANDROID_API__ >= 9
+static PocketFileReadStatus ReadPocketFile(AAssetManager *mgr,
+                                           const std::string &path,
+                                           std::vector<char> *data) {
+  data->clear();
+  AAsset *asset = AAssetManager_open(mgr, path.c_str(), AASSET_MODE_BUFFER);
+  if (!asset) {
+    return PocketFileReadStatus::kMissing;
+  }
+  const void *buffer = AAsset_getBuffer(asset);
+  auto raw_size = AAsset_getLength(asset);
+  if (raw_size < 0 ||
+      static_cast<uint64_t>(raw_size) >
+          std::numeric_limits<size_t>::max()) {
+    AAsset_close(asset);
+    return PocketFileReadStatus::kError;
+  }
+  size_t size = static_cast<size_t>(raw_size);
+  if (size != 0 && !buffer) {
+    AAsset_close(asset);
+    return PocketFileReadStatus::kError;
+  }
+  const char *begin = static_cast<const char *>(buffer);
+  if (size != 0) {
+    data->assign(begin, begin + size);
+  }
+  AAsset_close(asset);
+  return PocketFileReadStatus::kRead;
+}
+#endif
