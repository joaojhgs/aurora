+
+static bool DecodePocketFloat32Le(const std::vector<char> &raw,
+                                  std::vector<float> *values) {
+  if (raw.empty() || raw.size() % sizeof(float) != 0) {
+    return false;
+  }
+  values->resize(raw.size() / sizeof(float));
+  const uint16_t endian_probe = 1;
+  bool little_endian =
+      *reinterpret_cast<const uint8_t *>(&endian_probe) == uint8_t{1};
+  if (little_endian) {
+    std::memcpy(values->data(), raw.data(), raw.size());
+    return true;
+  }
+  for (size_t i = 0; i < values->size(); ++i) {
+    size_t offset = i * sizeof(float);
+    const auto *bytes = reinterpret_cast<const uint8_t *>(raw.data() + offset);
+    uint32_t bits = static_cast<uint32_t>(bytes[0]) |
+                    (static_cast<uint32_t>(bytes[1]) << 8) |
+                    (static_cast<uint32_t>(bytes[2]) << 16) |
+                    (static_cast<uint32_t>(bytes[3]) << 24);
+    std::memcpy(&(*values)[i], &bits, sizeof(bits));
+  }
+  return true;
+}
