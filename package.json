{
  "name": "aurora-workspace",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:web-persistence": "pnpm --filter @aurora/ui build && playwright test --config tests/e2e/browser_persistence/playwright.config.ts",
    "test:webrtc:interop": "scripts/webrtc_interop_local.sh direct",
    "test:webrtc:turn": "scripts/webrtc_interop_local.sh turn",
    "test:webrtc:browsers": "scripts/webrtc_interop_browser_matrix.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "5.7.3",
    "vitest": "^4.0.16"
  }
}
