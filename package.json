{
  "name": "aurora-workspace",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "tauri": "pnpm --filter @aurora/tauri-ui tauri",
    "dev:desktop-local": "pnpm --filter @aurora/tauri-ui dev:desktop-local",
    "dev:desktop-thin": "pnpm --filter @aurora/tauri-ui dev:desktop-thin",
    "dev:web-thin": "pnpm --filter @aurora/web dev:web-thin",
    "dev:python": "pnpm dev:python-service",
    "dev:python-service": "AURORA_ARCHITECTURE_MODE=threads AURORA_UI_ACTIVATE=false PYTHONUNBUFFERED=1 uv run python main.py",
    "test:web-persistence": "node scripts/run_browser_storage_gate.mjs",
    "test:web-thin:live": "scripts/hosted_thin_shell_e2e.sh",
    "test:webrtc:interop": "scripts/webrtc_interop_local.sh direct",
    "test:webrtc:turn": "scripts/webrtc_interop_local.sh turn",
    "test:webrtc:browsers": "scripts/webrtc_interop_browser_matrix.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.27.7",
    "typescript": "5.7.3",
    "vitest": "^4.0.16"
  }
}
