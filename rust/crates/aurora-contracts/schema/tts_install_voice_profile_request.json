{
  "$defs": {
    "MeshAddressSelector": {
      "description": "Explicit mesh target selector for safety-sensitive remote calls.\n\nThe selector is optional on bus payloads so transparent module routing\nremains backward compatible. When present, routing treats peer/provider\nfields as binding hints and validates them before falling back to module\nselection.",
      "properties": {
        "data_scope": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope"
        },
        "hardware_target": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Target"
        },
        "peer_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Id"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "resource_namespace": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Namespace"
        },
        "service_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Instance Id"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        }
      },
      "title": "MeshAddressSelector",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Install a manifest-known voice profile.",
  "properties": {
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "expected_revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "mesh_selector": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshAddressSelector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string",
      "x-aurora-tts-operation-id": true
    },
    "voice_id": {
      "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
      "title": "Voice Id",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "voice_id"
  ],
  "title": "TTSInstallVoiceProfileRequest",
  "type": "object",
  "x-aurora-extra-behavior": "forbid"
}
