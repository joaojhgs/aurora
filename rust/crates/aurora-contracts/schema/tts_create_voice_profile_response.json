{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Created cloned voice profile response.",
  "properties": {
    "accepted_duration_ms": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 15000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Duration Ms"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "status": {
      "enum": [
        "created",
        "queued",
        "ready",
        "rejected",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "voice_id": {
      "anyOf": [
        {
          "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Id"
    }
  },
  "required": [
    "status"
  ],
  "title": "TTSCreateVoiceProfileResponse",
  "type": "object",
  "x-aurora-extra-behavior": "forbid",
  "x-aurora-tts-create-profile-response-invariant": true
}
