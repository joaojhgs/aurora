{
  "$defs": {
    "MeshAddressSelector": {
      "description": "Explicit mesh target selector for safety-sensitive remote calls.\n\nThe selector is optional on bus payloads so transparent module routing\nremains backward compatible. When present, routing treats peer/provider\nfields as binding hints and validates them before falling back to module\nselection.",
      "properties": {
        "data_scope": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope"
        },
        "hardware_target": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Target"
        },
        "peer_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Id"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "resource_namespace": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Namespace"
        },
        "service_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Instance Id"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        }
      },
      "title": "MeshAddressSelector",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Audio chunk for processing.",
  "properties": {
    "caller_device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Device Id"
    },
    "caller_peer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Peer Id"
    },
    "caller_principal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Principal Id"
    },
    "channels": {
      "maximum": 8,
      "minimum": 1,
      "title": "Channels",
      "type": "integer"
    },
    "consent_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consent Token"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "data": {
      "format": "binary",
      "title": "Data",
      "type": "string"
    },
    "format": {
      "default": "pcm_s16le",
      "title": "Format",
      "type": "string"
    },
    "mesh_selector": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshAddressSelector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "privacy_class": {
      "default": "microphone",
      "title": "Privacy Class",
      "type": "string"
    },
    "privacy_indicator_state": {
      "default": "required",
      "title": "Privacy Indicator State",
      "type": "string"
    },
    "sample_rate": {
      "exclusiveMinimum": 0,
      "maximum": 192000,
      "title": "Sample Rate",
      "type": "integer"
    },
    "sample_width": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Width"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "target_device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Device Id"
    },
    "target_peer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Peer Id"
    }
  },
  "required": [
    "channels",
    "data",
    "sample_rate"
  ],
  "title": "STTAudioChunk",
  "type": "object",
  "x-aurora-extra-behavior": "strip"
}
