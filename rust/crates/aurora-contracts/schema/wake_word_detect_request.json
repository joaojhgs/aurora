{
  "$defs": {
    "MeshAddressSelector": {
      "description": "Explicit mesh target selector for safety-sensitive remote calls.\n\nThe selector is optional on bus payloads so transparent module routing\nremains backward compatible. When present, routing treats peer/provider\nfields as binding hints and validates them before falling back to module\nselection.",
      "properties": {
        "data_scope": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope"
        },
        "hardware_target": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Target"
        },
        "peer_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Id"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "resource_namespace": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Namespace"
        },
        "service_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Instance Id"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        }
      },
      "title": "MeshAddressSelector",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request to check audio for wake word (for external API).\n\nAudio should be provided as base64-encoded data.",
  "properties": {
    "audio_data": {
      "title": "Audio Data",
      "type": "string"
    },
    "channels": {
      "default": 1,
      "maximum": 8,
      "minimum": 1,
      "title": "Channels",
      "type": "integer"
    },
    "format": {
      "default": "raw",
      "title": "Format",
      "type": "string"
    },
    "mesh_selector": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshAddressSelector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sample_rate": {
      "default": 16000,
      "exclusiveMinimum": 0,
      "maximum": 192000,
      "title": "Sample Rate",
      "type": "integer"
    }
  },
  "required": [
    "audio_data"
  ],
  "title": "WakeWordDetectRequest",
  "type": "object",
  "x-aurora-extra-behavior": "strip"
}
