{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Install voice profile result.",
  "properties": {
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "idempotent": {
      "default": false,
      "title": "Idempotent",
      "type": "boolean"
    },
    "revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "status": {
      "enum": [
        "installed",
        "not_found",
        "queued",
        "rejected",
        "revision_conflict",
        "unchanged"
      ],
      "title": "Status",
      "type": "string"
    },
    "voice_id": {
      "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
      "title": "Voice Id",
      "type": "string"
    }
  },
  "required": [
    "status",
    "voice_id"
  ],
  "title": "TTSInstallVoiceProfileResponse",
  "type": "object",
  "x-aurora-extra-behavior": "forbid",
  "x-aurora-tts-profile-mutation-response-invariant": true
}
