{
  "$defs": {
    "TTSCloneVoiceStateBundle": {
      "additionalProperties": false,
      "description": "Portable cloned voice-state bundle containing derived state only.",
      "properties": {
        "artifact_data_base64": {
          "maxLength": 2796204,
          "title": "Artifact Data Base64",
          "type": "string"
        },
        "artifact_format": {
          "const": "safetensors",
          "default": "safetensors",
          "title": "Artifact Format",
          "type": "string"
        },
        "artifact_revision": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Artifact Revision",
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "artifact_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2097152,
          "title": "Artifact Size Bytes",
          "type": "integer"
        },
        "bundle_type": {
          "const": "aurora-cloned-tts-voice-state",
          "default": "aurora-cloned-tts-voice-state",
          "title": "Bundle Type",
          "type": "string"
        },
        "compatibility_group": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Compatibility Group",
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        "language_bundle": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Language Bundle",
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        "runtime_target": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Runtime Target",
          "type": "string",
          "x-aurora-string-non-blank": true
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "voice_id": {
          "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "title": "Voice Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_data_base64",
        "artifact_revision",
        "artifact_sha256",
        "artifact_size_bytes",
        "compatibility_group",
        "display_name",
        "language_bundle",
        "runtime_target",
        "voice_id"
      ],
      "title": "TTSCloneVoiceStateBundle",
      "type": "object",
      "x-aurora-extra-behavior": "forbid",
      "x-aurora-tts-clone-state-bundle-invariant": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manager-authorized cloned voice state export response.",
  "properties": {
    "bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/TTSCloneVoiceStateBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "idempotent": {
      "default": false,
      "title": "Idempotent",
      "type": "boolean"
    },
    "revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "status": {
      "enum": [
        "exported",
        "not_found",
        "rejected",
        "revision_conflict",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "voice_id": {
      "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
      "title": "Voice Id",
      "type": "string"
    }
  },
  "required": [
    "status",
    "voice_id"
  ],
  "title": "TTSExportVoiceProfileResponse",
  "type": "object",
  "x-aurora-extra-behavior": "forbid",
  "x-aurora-tts-export-profile-response-invariant": true
}
