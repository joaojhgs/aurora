{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Synthesized audio chunk emitted for a TTS streaming session.",
  "properties": {
    "audio_data": {
      "title": "Audio Data",
      "type": "string"
    },
    "channels": {
      "default": 1,
      "maximum": 8,
      "minimum": 1,
      "title": "Channels",
      "type": "integer"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "format": {
      "title": "Format",
      "type": "string"
    },
    "is_final": {
      "default": false,
      "title": "Is Final",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "sample_rate": {
      "maximum": 192000,
      "minimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source_sequence": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sequence"
    },
    "stream_id": {
      "title": "Stream Id",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "required": [
    "audio_data",
    "duration_ms",
    "format",
    "sample_rate",
    "sequence",
    "stream_id"
  ],
  "title": "TTSAudioChunkEvent",
  "type": "object",
  "x-aurora-extra-behavior": "strip",
  "x-aurora-tts-audio-chunk-event-invariant": true
}
