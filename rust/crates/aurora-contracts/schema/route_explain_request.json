{
  "$defs": {
    "MeshAddressSelector": {
      "description": "Explicit mesh target selector for safety-sensitive remote calls.\n\nThe selector is optional on bus payloads so transparent module routing\nremains backward compatible. When present, routing treats peer/provider\nfields as binding hints and validates them before falling back to module\nselection.",
      "properties": {
        "data_scope": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope"
        },
        "hardware_target": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Target"
        },
        "peer_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Id"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "resource_namespace": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Namespace"
        },
        "service_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Instance Id"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string",
              "x-aurora-string-non-blank": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        }
      },
      "title": "MeshAddressSelector",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    },
    "RouteExplainSpeechConstraints": {
      "additionalProperties": false,
      "description": "Typed speech routing hints for ExplainRoute without request payload data.",
      "properties": {
        "language_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechLanguageRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "voice_id": {
          "anyOf": [
            {
              "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Id"
        }
      },
      "title": "RouteExplainSpeechConstraints",
      "type": "object",
      "x-aurora-extra-behavior": "forbid"
    },
    "SpeechLanguageRequirement": {
      "additionalProperties": false,
      "description": "Canonical language requirement used by route policy and target checks.",
      "properties": {
        "auto_language_candidates": {
          "items": {
            "maxLength": 255,
            "minLength": 2,
            "pattern": "^(?:[a-z]{2,8}(?:-[a-z0-9]{1,8})*|[ix](?:-[a-z0-9]{1,8})+)$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Auto Language Candidates",
          "type": "array",
          "x-aurora-speech-language-array-normalize": true
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 2,
              "pattern": "^(?:[a-z]{2,8}(?:-[a-z0-9]{1,8})*|[ix](?:-[a-z0-9]{1,8})+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language",
          "x-aurora-speech-language-string-normalize": true
        },
        "mode": {
          "enum": [
            "auto",
            "exact"
          ],
          "title": "Mode",
          "type": "string"
        },
        "table_revision": {
          "const": "aurora-speech-language-v2",
          "default": "aurora-speech-language-v2",
          "title": "Table Revision",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "SpeechLanguageRequirement",
      "type": "object",
      "x-aurora-extra-behavior": "forbid",
      "x-aurora-speech-language-requirement": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explain how Gateway would route a topic/module selector.",
  "properties": {
    "include_candidates": {
      "default": true,
      "title": "Include Candidates",
      "type": "boolean"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "module": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module"
    },
    "selector": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshAddressSelector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "speech": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteExplainSpeechConstraints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "topic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topic"
    }
  },
  "title": "RouteExplainRequest",
  "type": "object",
  "x-aurora-extra-behavior": "forbid",
  "x-aurora-route-explain-no-raw-payload": true,
  "x-aurora-route-explain-selector-fields": true,
  "x-aurora-route-explain-speech-no-raw-payload": true
}
