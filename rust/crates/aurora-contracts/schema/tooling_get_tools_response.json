{
  "$defs": {
    "ToolingRateLimitHints": {
      "description": "Optional rate-limit hints for a discovered tool provider.",
      "properties": {
        "max_calls": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calls"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "window_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Seconds"
        }
      },
      "title": "ToolingRateLimitHints",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    },
    "ToolingToolInfo": {
      "description": "Typed metadata for a discovered tool.\n\n``name`` remains the bindable tool name expected by existing\norchestrator code. For local-only discovery it is the provider-local\nname; for provider-selected mesh discovery it is namespaced to avoid\ncollisions.",
      "properties": {
        "admin": {
          "default": false,
          "title": "Admin",
          "type": "boolean"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "args_schema": {
          "additionalProperties": {
            "x-aurora-json-value": true
          },
          "title": "Args Schema",
          "type": "object",
          "x-aurora-extra-behavior": "preserve"
        },
        "argument_visibility": {
          "additionalProperties": {
            "enum": [
              "display",
              "hash_only",
              "raw_never",
              "secret",
              "support_bundle_redacted"
            ],
            "type": "string"
          },
          "title": "Argument Visibility",
          "type": "object",
          "x-aurora-extra-behavior": "preserve"
        },
        "capability_class": {
          "default": "read",
          "enum": [
            "admin",
            "device",
            "execute",
            "network",
            "read",
            "secrets",
            "write"
          ],
          "title": "Capability Class",
          "type": "string"
        },
        "confirmation_required": {
          "default": false,
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "data_egress": {
          "default": false,
          "title": "Data Egress",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "execution_location": {
          "default": "local",
          "enum": [
            "local",
            "remote"
          ],
          "title": "Execution Location",
          "type": "string"
        },
        "exportable": {
          "default": false,
          "title": "Exportable",
          "type": "boolean"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        },
        "global_tool_id": {
          "title": "Global Tool Id",
          "type": "string"
        },
        "legacy_global_tool_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Legacy Global Tool Ids",
          "type": "array",
          "x-aurora-unique-string-array-normalize": true
        },
        "local_name": {
          "title": "Local Name",
          "type": "string"
        },
        "mutating": {
          "default": false,
          "title": "Mutating",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "privacy_hints": {
          "items": {
            "type": "string"
          },
          "title": "Privacy Hints",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ToolingToolProvenance"
        },
        "provider_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Available"
        },
        "provider_granted_permissions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Granted Permissions"
        },
        "provider_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Label"
        },
        "provider_peer_id": {
          "title": "Provider Peer Id",
          "type": "string"
        },
        "provider_service_instance_id": {
          "title": "Provider Service Instance Id",
          "type": "string"
        },
        "rate_limit_hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolingRateLimitHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_permissions": {
          "items": {
            "type": "string"
          },
          "title": "Required Permissions",
          "type": "array"
        },
        "resource_scope": {
          "items": {
            "type": "string"
          },
          "title": "Resource Scope",
          "type": "array"
        },
        "risk_class": {
          "default": "standard",
          "enum": [
            "dangerous",
            "sensitive",
            "standard"
          ],
          "title": "Risk Class",
          "type": "string"
        },
        "safety_class": {
          "default": "standard",
          "enum": [
            "dangerous",
            "sensitive",
            "standard"
          ],
          "title": "Safety Class",
          "type": "string"
        },
        "schema": {
          "additionalProperties": {
            "x-aurora-json-value": true
          },
          "title": "Schema",
          "type": "object",
          "x-aurora-extra-behavior": "preserve"
        },
        "share_group_id": {
          "default": "",
          "title": "Share Group Id",
          "type": "string"
        },
        "share_group_label": {
          "default": "",
          "title": "Share Group Label",
          "type": "string"
        },
        "source": {
          "default": "unknown",
          "enum": [
            "core",
            "mcp",
            "mesh_peer",
            "plugin",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_type": {
          "default": "local",
          "enum": [
            "local",
            "mesh_peer"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "tool_contract_id": {
          "default": "",
          "title": "Tool Contract Id",
          "type": "string"
        },
        "tool_id_scheme": {
          "default": "legacy",
          "enum": [
            "aurora-tool",
            "legacy"
          ],
          "title": "Tool Id Scheme",
          "type": "string"
        },
        "tool_id_version": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Tool Id Version",
          "type": "integer"
        },
        "trust_tier": {
          "default": "untrusted",
          "enum": [
            "blocked",
            "trusted",
            "untrusted"
          ],
          "title": "Trust Tier",
          "type": "string"
        }
      },
      "required": [
        "display_name",
        "global_tool_id",
        "local_name",
        "name",
        "namespace",
        "provenance",
        "provider_peer_id",
        "provider_service_instance_id"
      ],
      "title": "ToolingToolInfo",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    },
    "ToolingToolProvenance": {
      "description": "Provenance carried with a discovered tool.",
      "properties": {
        "advertised_name": {
          "title": "Advertised Name",
          "type": "string"
        },
        "provider_kind": {
          "default": "local",
          "enum": [
            "local",
            "mesh_peer"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "provider_peer_id": {
          "title": "Provider Peer Id",
          "type": "string"
        },
        "provider_service_instance_id": {
          "title": "Provider Service Instance Id",
          "type": "string"
        },
        "provider_tool_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Tool Id"
        },
        "source": {
          "default": "unknown",
          "enum": [
            "core",
            "mcp",
            "plugin",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "stable_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stable Source Id"
        }
      },
      "required": [
        "advertised_name",
        "provider_peer_id",
        "provider_service_instance_id"
      ],
      "title": "ToolingToolProvenance",
      "type": "object",
      "x-aurora-extra-behavior": "strip"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response with available tools.",
  "properties": {
    "count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolingToolInfo"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "count",
    "tools"
  ],
  "title": "ToolingGetToolsResponse",
  "type": "object",
  "x-aurora-extra-behavior": "strip"
}
