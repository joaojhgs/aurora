{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Negotiate speech-session-v1 before using legacy TTS stream frames.",
  "properties": {
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "capability_revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Capability Revision",
      "type": "integer"
    },
    "config_revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Config Revision",
      "type": "integer"
    },
    "consent_revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consent Revision"
    },
    "exact_selector": {
      "default": false,
      "title": "Exact Selector",
      "type": "boolean"
    },
    "experimental_remote": {
      "default": false,
      "title": "Experimental Remote",
      "type": "boolean"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "interrupt": {
      "default": false,
      "title": "Interrupt",
      "type": "boolean"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 2,
          "pattern": "^(?:[a-z]{2,8}(?:-[a-z0-9]{1,8})*|[ix](?:-[a-z0-9]{1,8})+)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language",
      "x-aurora-speech-language-string-normalize": true
    },
    "mode": {
      "const": "streaming",
      "default": "streaming",
      "title": "Mode",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operation Id",
      "type": "string",
      "x-aurora-tts-operation-id": true
    },
    "play_on_server": {
      "default": false,
      "title": "Play On Server",
      "type": "boolean"
    },
    "remaining_deadline_ms": {
      "default": 60000,
      "exclusiveMinimum": 0,
      "maximum": 60000,
      "title": "Remaining Deadline Ms",
      "type": "integer"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "route_revision": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Route Revision",
      "type": "string"
    },
    "schema": {
      "const": "speech-stage-admission.v1",
      "default": "speech-stage-admission.v1",
      "title": "Schema",
      "type": "string"
    },
    "stage": {
      "const": "tts",
      "default": "tts",
      "title": "Stage",
      "type": "string"
    },
    "target_peer_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Peer Id"
    },
    "target_resource_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Resource Id"
    },
    "voice": {
      "anyOf": [
        {
          "pattern": "^(?:standard:[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}|clone:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice"
    }
  },
  "required": [
    "attempt_id",
    "capability_revision",
    "config_revision",
    "generation",
    "operation_id",
    "request_id",
    "route_revision"
  ],
  "title": "TTSStreamPrepareRequest",
  "type": "object",
  "x-aurora-extra-behavior": "forbid"
}
