+def _resident_whisper_identity(model: Any) -> str | None:
+    """Hash the actual constructor-selected weight off the event-loop thread."""
+    provenance = getattr(model, "_aurora_resident_weight", None)
+    if not isinstance(provenance, tuple) or len(provenance) != 2:
+        return None
+    path, expected = provenance
+    def signature():
+        stat = os.stat(path)
+        return (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)
+    if signature() != expected:
+        return None
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    if signature() != expected:
+        return None
+    return "faster-whisper:sha256:" + digest.hexdigest()
 
 
