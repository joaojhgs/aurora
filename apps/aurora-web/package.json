{
  "name": "@aurora/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:web": "node ./scripts/dev-ui-launch.mjs debug",
    "dev:web-thin": "pnpm dev:web",
    "dev:ui:debug": "node ./scripts/dev-ui-launch.mjs debug",
    "dev:ui:web-remote": "node ./scripts/dev-ui-launch.mjs web-remote",
    "dev:ui:web-remote-admin": "node ./scripts/dev-ui-launch.mjs web-remote-admin",
    "dev:ui:web-node": "node ./scripts/dev-ui-launch.mjs web-node",
    "dev:ui:desktop-local": "node ./scripts/dev-ui-launch.mjs desktop-local",
    "dev:ui:desktop-thin-remote": "node ./scripts/dev-ui-launch.mjs desktop-thin-remote",
    "dev:ui:desktop-node": "node ./scripts/dev-ui-launch.mjs desktop-node",
    "dev:ui:android-remote": "node ./scripts/dev-ui-launch.mjs android-remote",
    "dev:ui:android-node": "node ./scripts/dev-ui-launch.mjs android-node",
    "dev:ui:ios-remote": "node ./scripts/dev-ui-launch.mjs ios-remote",
    "dev:ui:ios-node": "node ./scripts/dev-ui-launch.mjs ios-node",
    "dev:ui:mobile-node": "node ./scripts/dev-ui-launch.mjs mobile-node",
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --environment node",
    "test:browser:voice": "pnpm --dir ../.. --filter @aurora/voice-web run build && pnpm exec playwright test --config tests/playwright/assistant-browser-voice.playwright.config.ts",
    "build:release-dependencies": "pnpm --dir ../.. --filter @aurora/ui build && pnpm --dir ../.. --filter @aurora/mesh-authority-web build",
    "package:unsigned": "pnpm build:release-dependencies && pnpm build && node scripts/package-web-release.mjs && pnpm verify:package:unsigned",
    "verify:package:unsigned": "node scripts/assert-web-release-artifact-clean.mjs",
    "test:coverage": "vitest run --environment node --coverage"
  },
  "dependencies": {
    "@aurora/client": "workspace:*",
    "@aurora/mesh-authority-web": "workspace:*",
    "@aurora/ui": "workspace:*",
    "next": "16.2.11",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^27.4.0",
    "typescript": "5.7.3",
    "vitest": "^4.0.16"
  }
}
