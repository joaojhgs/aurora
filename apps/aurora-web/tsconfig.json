{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-thin-remote/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-thin-remote/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/web-remote/types/**/*.ts",
    "/tmp/aurora-ui-next/web-remote/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/ios-node/types/**/*.ts",
    "/tmp/aurora-ui-next/ios-node/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-node/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-node/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/web-remote-admin/types/**/*.ts",
    "/tmp/aurora-ui-next/web-remote-admin/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/android-remote/types/**/*.ts",
    "/tmp/aurora-ui-next/android-remote/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/android-node/types/**/*.ts",
    "/tmp/aurora-ui-next/android-node/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/web-node/types/**/*.ts",
    "/tmp/aurora-ui-next/web-node/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-local/types/**/*.ts",
    "/tmp/aurora-ui-next/desktop-local/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/ios-remote/types/**/*.ts",
    "/tmp/aurora-ui-next/ios-remote/dev/types/**/*.ts",
    "/tmp/aurora-ui-next/mobile-node/types/**/*.ts",
    "/tmp/aurora-ui-next/mobile-node/dev/types/**/*.ts",
    "tmp/aurora-ui-next/debug/types/**/*.ts",
    "tmp/aurora-ui-next/debug/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
