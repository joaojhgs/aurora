{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "0.1.0",
  "identifier": "dev.aurora.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Aurora",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "capabilities": [
        "aurora-main",
        "aurora-overlay",
        "aurora-mobile-mesh"
      ],
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "msi",
      "nsis"
    ],
    "publisher": "Aurora contributors",
    "category": "Productivity",
    "shortDescription": "Privacy-first modular voice assistant desktop shell.",
    "longDescription": "Aurora desktop packages the official Tauri 2 shell with a constrained AuroraClient bridge, signed updater artifacts, and an explicitly prepared local sidecar binary for Desktop Local mode.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/aurora-desktop-icon.png",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 100
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aurora"
        ]
      },
      "mobile": []
    },
    "updater": {
      "pubkey": "AURORA_RELEASE_PUBLIC_KEY_REPLACE_BEFORE_RELEASE",
      "endpoints": [
        "https://releases.aurora.local/latest/{{target}}/{{arch}}/{{current_version}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "sql": {
      "preload": [
        "sqlite:aurora-lightweight.db"
      ]
    }
  }
}
