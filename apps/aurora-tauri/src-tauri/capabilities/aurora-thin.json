{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "aurora-thin",
  "description": "Python-free desktop thin shell capability. Grants native shell status/storage helpers only; no sidecar lifecycle, local SDK request bridge, Python resources, or local service bootstrap permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "deep-link:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "aurora-native-capability-manifest",
    "aurora-native-permissions",
    "aurora-thin-profile",
    "aurora-thin-peer-credentials",
    "aurora-local-data-envelope-crypto",
    "aurora-native-webrtc",
    "aurora-tray",
    "aurora-notifications",
    "aurora-dialogs",
    "aurora-shutdown"
  ]
}
